function loop(t){if(state?.phase==='playing'&&t-lastSend>40){const dx=(keys.a||keys.arrowleft?-1:0)+(keys.d||keys.arrowright?1:0),dy=(keys.w||keys.arrowup?-1:0)+(keys.s||keys.arrowdown?1:0);const action=keys[' ']?'jump':null;socket.emit('input',{dx,dy,action});lastSend=t;$('timer').textContent=Math.max(0,Math.ceil((state.endsAt-Date.now())/1000));draw(state);}requestAnimationFrame(loop)}requestAnimationFrame(loop);
