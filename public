<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GRAVEL PARTY // field trials</title><link rel="stylesheet" href="style.css"></head><body>
<div class="noise"></div><main><header><div class="brand"><span class="mark">GP</span><div><h1>GRAVEL PARTY</h1><p>REMOTE FIELD TRIALS // BUILD 0.1</p></div></div><div class="status"><i></i> SERVER LINK ACTIVE</div></header>
<section id="menu" class="panel menu"><div class="eyebrow">/// UNAUTHORIZED RECREATION DEPARTMENT</div><h2>FRIENDSHIP IS A<br><em>CONTACT SPORT.</em></h2><p class="intro">A scrappy online party game for 2–4 players. Survive the trials, outscore your friends, and try not to fall into the scenery.</p><label for="playerName">CALLSIGN</label><input id="playerName" maxlength="16" value="Road Gremlin" placeholder="Your name"><div class="joinrow"><button id="createBtn" class="primary">HOST A ROOM ↗</button><input id="roomCode" maxlength="4" placeholder="CODE"><button id="joinBtn">JOIN</button></div><div class="hint">WASD / ARROWS TO MOVE · SPACE TO ACT / JUMP · 5 ROUNDS</div><div id="menuError" class="error"></div></section>
<section id="lobby" class="panel hidden"><div class="eyebrow">/// CONNECTION ESTABLISHED</div><div class="lobbytop"><div><h2>ROOM <span id="roomLabel">----</span></h2><p>Send the code to your crew.</p></div><button id="copyBtn">COPY CODE</button></div><div id="players" class="players"></div><div class="lobbybottom"><p id="lobbyNote">Waiting for more players… minimum 2.</p><button id="startBtn" class="primary">START TRIALS →</button></div></section>
<section id="game" class="hidden"><div class="gamehead"><div><div class="eyebrow">LIVE SIMULATION <span id="roundLabel">01 / 05</span></div><h2 id="gameTitle">CONVEYOR SCRAMBLE</h2><p id="gameDesc"></p></div><div class="timer"><span>TIME LEFT</span><strong id="timer">25</strong></div></div><div class="arena"><canvas id="scene" width="1000" height="560"></canvas><div class="arenaLabel">CAM 01 // TEST CHAMBER</div><div class="crosshair">+</div></div><div class="gamefoot"><span id="gameHint">WASD TO MOVE · SPACE TO ACT</span><span id="liveCode">ROOM ----</span></div></section>
