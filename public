function name(){return $('playerName').value.trim()||'Road Gremlin'}
$('createBtn').onclick=()=>{ $('menuError').textContent='';socket.emit('create',{name:name()});};$('joinBtn').onclick=()=>{ $('menuError').textContent='';socket.emit('join',{name:name(),code:$('roomCode').value.trim().toUpperCase()});};$('startBtn').onclick=()=>socket.emit('start');$('againBtn').onclick=()=>socket.emit('start');$('copyBtn').onclick=async()=>{try{await navigator.clipboard.writeText(room);toast('ROOM CODE COPIED: '+room)}catch(e){toast('SHARE THIS CODE: '+room)}};
