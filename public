<footer><span>GRAVEL PARTY / UNOFFICIAL ORIGINAL PROTOTYPE</span><span>NO GORE. ALL GLORY.</span></footer></main><div id="toast" class="toast"></div><script src="/socket.io/socket.io.js"></script><script src="app.js"></script></body></html>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap');
:root{--ink:#e8e5d8;--muted:#9d9e8e;--rust:#df704a;--acid:#d6e17c;--panel:#181d1b;--line:#48504a}*{box-sizing:border-box}body{margin:0;background:#101513;color:var(--ink);font-family:'Space Mono',monospace;min-height:100vh;background-image:radial-gradient(ellipse at 50% 0%,#28332c 0%,#101513 65%)}.noise{pointer-events:none;position:fixed;inset:0;opacity:.12;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.3'/%3E%3C/svg%3E")}
main{max-width:1080px;margin:auto;padding:24px 28px 18px}header,.brand,.status,.joinrow,.lobbytop,.lobbybottom,.gamehead,.gamefoot,footer{display:flex;align-items:center;justify-content:space-between}header{padding:6px 0 24px;border-bottom:1px solid var(--line);margin-bottom:28px}.brand{justify-content:flex-start;gap:12px}.mark{display:grid;place-items:center;width:48px;height:48px;background:var(--rust);color:#1a1b16;font-family:'Barlow Condensed';font-size:24px;font-weight:900;clip-path:polygon(0 0,100% 0,100% 75%,75% 100%,0 100%)}h1,h2,p{margin:0}h1{font:800 24px 'Barlow Condensed';letter-spacing:2px}header p,.eyebrow,.status,footer,.hint,.arenaLabel,.gamefoot,.timer span{font-size:10px;letter-spacing:1.5px;color:var(--muted)}.status{gap:9px}.status i{width:7px;height:7px;border-radius:50%;background:var(--acid);box-shadow:0 0 10px var(--acid)}.panel{background:linear-gradient(135deg,#202723,#171c19);border:1px solid var(--line);padding:30px;position:relative;box-shadow:8px 8px 0 #090c0b}.menu{max-width:760px;margin:0 auto 30px}.eyebrow{color:var(--acid);margin-bottom:16px}.menu h2,.panel h2,.gamehead h2{font:900 clamp(36px,6vw,66px)/.88 'Barlow Condensed';letter-spacing:1px;margin-bottom:18px}.menu h2 em{font-style:normal;color:var(--rust)}.intro{max-width:490px;color:#b5b9ac;font-size:12px;line-height:1.8;margin:20px 0 26px}label{display:block;font-size:10px;color:var(--muted);letter-spacing:1.5px;margin-bottom:8px}input{background:#101512;border:1px solid #4c554d;color:var(--ink);font:12px 'Space Mono';padding:13px 14px;outline:none;min-width:0}input:focus{border-color:var(--acid)}#playerName{width:100%;margin-bottom:14px}.joinrow{gap:9px;justify-content:flex-start}.joinrow #roomCode{width:110px;text-transform:uppercase;text-align:center;letter-spacing:3px}.joinrow button{flex:1}button{background:#252d28;border:1px solid #606a5d;color:var(--ink);font:700 11px 'Space Mono';letter-spacing:1px;padding:14px 18px;cursor:pointer;transition:.15s}button:hover{transform:translateY(-2px);border-color:var(--acid);color:var(--acid)}button.primary{background:var(--acid);color:#171b14;border-color:var(--acid)}button.primary:hover{background:#e7f19b;color:#111}button:disabled{opacity:.4;cursor:not-allowed;transform:none}.hint{margin-top:20px;font-size:9px}.error{color:#ff9b7d;font-size:11px;margin-top:12px;min-height:14px}.hidden{display:none!important}.lobbytop h2,.panel>h2{font-size:44px}.lobbytop h2 span{color:var(--rust)}.lobbytop p,.lobbybottom p{color:var(--muted);font-size:11px;margin-top:6px}.players{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:26px 0}.playercard{border:1px solid var(--line);padding:16px;background:#111613;min-height:110px}.playercard .avatar{width:28px;height:34px;margin-bottom:15px;clip-path:polygon(20% 0,80% 0,100% 25%,90% 100%,10% 100%,0 25%)}.playercard strong{display:block;font:700 18px 'Barlow Condensed';overflow:hidden;text-overflow:ellipsis}.playercard small{color:var(--muted);font-size:9px}.lobbybottom{padding-top:18px;border-top:1px solid var(--line)}.gamehead{align-items:flex-end;margin-bottom:18px}.gamehead h2{font-size:42px;margin-bottom:8px}.gamehead p{font-size:11px;color:var(--muted);max-width:600px;line-height:1.6}.timer{border:1px solid var(--rust);padding:10px 18px;text-align:center;min-width:100px}.timer span{display:block;font-size:8px}.timer strong{font:800 42px 'Barlow Condensed';color:var(--rust)}.arena{position:relative;border:1px solid #52594b;background:#1d2722;overflow:hidden;box-shadow:8px 8px 0 #090c0b}.arena canvas{display:block;width:100%;height:auto;aspect-ratio:1000/560}.arenaLabel{position:absolute;top:12px;left:14px;background:#111b;padding:7px}.crosshair{position:absolute;left:50%;top:50%;color:#d9e17a;opacity:.35}.gamefoot{padding:14px 2px}.scoreboard{display:grid;gap:8px;margin:20px 0}.scoreRow{display:grid;grid-template-columns:1fr 70px;align-items:center;background:#111613;border:1px solid var(--line);padding:13px 16px}.scoreRow strong{font:700 20px 'Barlow Condensed'}.scoreRow b{text-align:right;color:var(--acid);font:800 24px 'Barlow Condensed'}.panel #resultNote{font-size:11px;color:var(--muted)}footer{border-top:1px solid var(--line);margin-top:28px;padding-top:16px;font-size:9px}.toast{position:fixed;left:50%;bottom:30px;transform:translate(-50%,20px);background:var(--acid);color:#141a13;padding:14px 20px;font-size:11px;font-weight:bold;opacity:0;transition:.2s;pointer-events:none;max-width:90%;text-align:center}.toast.show{opacity:1;transform:translate(-50%,0)}@media(max-width:650px){main{padding:16px}.panel{padding:20px}.status{font-size:0}.players{grid-template-columns:repeat(2,1fr)}.joinrow{flex-wrap:wrap}.joinrow button{min-width:40%}.lobbybottom{gap:15px;align-items:flex-start;flex-direction:column}.gamehead{align-items:flex-start}.gamehead h2{font-size:32px}.timer{min-width:75px;padding:8px}.timer strong{font-size:30px}footer{gap:12px;align-items:flex-start;flex-direction:column}}

