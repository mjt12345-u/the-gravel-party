function renderPlayers(s){$('players').innerHTML='';for(let i=0;i<4;i++){const p=s.players[i];const d=document.createElement('div');d.className='playercard';d.innerHTML=p?`<div class="avatar" style="background:${p.color}"></div><strong>${esc(p.name)}</strong><small>CONNECTED · ${p.score} PTS</small>`:`<div class="avatar" style="background:#2b332e"></div><strong>EMPTY SLOT</strong><small>AWAITING PLAYER</small>`;$('players').appendChild(d)}}
function renderGameInfo(s){$('roundLabel').textContent=String(s.round).padStart(2,'0')+' / 05';$('gameTitle').textContent=s.game.name;$('gameDesc').textContent=s.game.desc;$('timer').textContent=Math.max(0,Math.ceil((s.endsAt-Date.now())/1000));$('gameHint').textContent=s.game.id==='scramble'?'MOVE TO SCRAP · SPACE TO COLLECT':s.game.id==='road'?'REACH THE RIGHT EDGE · SPACE TO DODGE':'STAY MOVING · SPACE TO HOP';}
function renderScore(s){$('scoreboard').innerHTML='';[...s.players].sort((a,b)=>b.score-a.score).forEach((p,i)=>{const d=document.createElement('div');d.className='scoreRow';d.innerHTML=`<strong><span style="color:${p.color}">0${i+1}</span> &nbsp;${esc(p.name)}</strong><b>${p.score} PTS</b>`;$('scoreboard').appendChild(d)});$('resultNote').textContent=s.phase==='final'?'ALL FIVE TRIALS COMPLETE. PLAY AGAIN?': 'Next trial loading…';$('againBtn').classList.toggle('hidden',s.phase!=='final'||!host);if(s.phase==='final')$('resultNote').textContent+=' Host can restart the series.';}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
